let x

x = (,)
assert(len(x) == 0)
x = (1,)
assert(len(x) == 1)
x = (1,2)
assert(len(x) == 2)
x = (1,2,)
assert(len(x) == 2)
x = (1,2,3)
assert(len(x) == 3)
x = (1,2,3,)
assert(len(x) == 3)
x = (1,2,3,4)
assert(len(x) == 4)

// sequence comprehension.
// --------------------------------------

let x

// literal body.

x = (true | a in (1,2,3))
assert(x == (true,true,true))

// variable body.

x = (a | a in (1,2,3))
assert(x == (1,2,3))

// expression body.

x = (a + 1 | a in (1,2,3))
assert(x == (2,3,4))

// as argument of global function.

global id = x => x
assert(id((x | x in (1,2))) == (1,2))

// as argument of local function.

let f = () => {
  let id = x => x
  assert(id((x | x in (1,2))) == (1,2))
}

f()

// product of iterable conditions.

x = ((a, b) | a in (1,2,3), b in (3,2,1))
assert(x == (
  (1,3),(1,2),(1,1),
  (2,3),(2,2),(2,1),
  (3,3),(3,2),(3,1)
))

// vacuous iterable condition.

x = (x | x in (1,2,3,4), y in (1,2))
assert(x == (1,1,2,2,3,3,4,4))

// vacuous condition.

x = (a | a in (1,2,3), true)
assert(x == (1,2,3))

x = (a | a in (1,2,3), false)
assert(x == (,))

// predicative condition anaphoric on previous condition.

x = (a | a in (1,2,3), a != 3)
assert(x == (1,2))

x = (a | a in (1,2,3), a != 3, a != 2)
assert(x == (1,))

// iterable condition anaphoric on previous condition.

x = (b | a in ((1,2),(3,4),(5,6)), b in a)
assert(x == (1,2,3,4,5,6))

x = (b + c | a in ((1,2),), b in (3,4), c in a)
assert(x == (4,5,5,6))

x = ((b, c) | a in ((1,2),(3,4)), b in a, c in a)
assert(x == (
  (1,1),
  (1,2),
  (2,1),
  (2,2),
  (3,3),
  (3,4),
  (4,3),
  (4,4)
))

// body comprehension.

x = ((b | b in a) | a in ((1,2),(3,), (4,5)))
assert(x == ((1,2), (3,), (4,5)))

// nested body comprehension.

x = (((c | c in b) | b in a) | a in (((1,2),),((3,),), ((4,5),)))
assert(x == (((1,2),), ((3,),), ((4,5),)))

// condition comprehension.

x = (x | x in (a | a in (1,2,3)))
assert(x == (1,2,3))

// condition comprehension, rebound variable.

x = (a | a in (a | a in (1,2,3)))
assert(x == (1,2,3))

// nested condition comprehension.

x = (x | x in (a | a in (b | b in (1,2,3))))
assert(x == (1,2,3))

// nested condition comprehension, rebound variable.

x = (a | a in (a | a in (a | a in (1,2,3))))
assert(x == (1,2,3))

// set comprehension in body.

x = ({a | a in b} | b in ((1,2), (3,4)))

assert(x[0] == {1,2})
assert(x[1] == {3,4})

// assignment to a local.

let f = () => {
  let x = (x | x in (1,2,3))
  assert(x == (1,2,3))
}

// assignment to a global property.

global a = {}
a["y"] = (z | z in (1,2))
assert(a["y"] == (1,2))

// assignment to a local property.

let f = () => {
  let a = {}
  a["y"] = (z | z in (1,2))
  assert(a["y"] == (1,2))
}

f()
