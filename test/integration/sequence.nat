let x

let comp

x = (,)
assert(len(x) == 0)
x = (1,)
assert(len(x) == 1)
x = (1,2)
assert(len(x) == 2)
x = (1,2,)
assert(len(x) == 2)
x = (1,2,3)
assert(len(x) == 3)
x = (1,2,3,)
assert(len(x) == 3)
x = (1,2,3,4)
assert(len(x) == 4)

comp = (y | y in (1,2,3), y != 2)
print(comp)
assert(len(comp) == 2)
assert(comp[0] == 1)
assert(comp[1] == 3)

comp = (y + 1 | y in (1,2))
assert(len(comp) == 2)
assert(comp[0] == 2)
assert(comp[1] == 3)

comp = ((z | z in (1,2)) | y in (4,5))
assert(len(comp) == 2)
assert(len(comp[0]) == 2)
assert(len(comp[1]) == 2)
assert(comp[0][0] == 1)
assert(comp[1][1] == 2)

comp = (y | y in (x | x in (1,2)))
assert(len(comp) == 2)
assert(comp[0] == 1)
assert(comp[1] == 2)
