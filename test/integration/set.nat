let s

// literal construction.

s = ({1})
assert(s[1])
assert(s[2] == false)

s = ({1, 2, 1})
assert(s[1])
assert(s[2])
assert(s[3] == false)

// from native function.

s = set(4, 5, 4)
assert(s[4])
assert(s[5])
assert(s[6] == false)

// api.

s = set()
setAdd(s, 4)
assert(s[4])
assert(s[5] == false)
