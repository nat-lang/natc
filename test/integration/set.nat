let s

// literal construction.

s = ({1})
assert(s[1])
assert(s[2] == false)

s = ({1, 2, 1})
assert(s[1])
assert(s[2])
assert(s[3] == false)

// from native function.

s = set(4, 5, 4)
assert(s[4])
assert(s[5])
assert(s[6] == false)

// api.

s = set()
setAdd(s, 4)
assert(s[4])
assert(s[5] == false)


// comprehension.

// literal body.
s = {true | a in (1,2,3)}
assert(s == {true})

// variable body.
s = {a | a in (1,2,3)}
assert(s == {1,2,3})

// nested body.
s = {{true | b in a} | a in ((1,2), (3,), (4,5))}
assert(s == {{true}})

s = {{b | b in a} | a in ((1,2), (3,), (4,5,5))}
assert(s == ({1,2}, {3}, {4,5}))

s = {a | a in ({1,2}, {3}, {4,5})}
assert(s == {{1,2}, {3}, {4,5}})

s = {{b | b in a} | a in ({1,2}, {3}, {4,5,5})}
assert(s == {{1,2}, {3}, {4,5}})

s = {{true | b in a} | a in ({1,2}, {3}, {4,5})}
assert(s == {{true}})

// nested condition.
s = {a | a in (a | a in (1,1,2,2,3,3))}
assert(s == {1,2,3})

s = {a | a in (a | a in {1,1,2,2,3,3})}
assert(s == {1,2,3})

// sequence comprehension in body.
s = {(a | a in b) | b in ((1,2), (3,4))}

assert(s[(3,4)])
assert(s[(1,2)])
