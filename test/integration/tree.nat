let t

// empty tree
t = []
assert(t.value == nil)

// simple leaf tree - single element is a child
t = [1]
assert(t[0] == 1)

// tree with value and children - first is value, rest are children
t = [1 2 3]
assert(t.value == 1)
assert(t[0] == 2)
assert(t[1] == 3)

// nested tree literals
t = [[1] [2] [3]]
// First element [1] is the value, [2] and [3] are children
assert(t.value[0] == 1)
assert(t[0][0] == 2)
assert(t[1][0] == 3)

// deeper nesting with values
t = [[1 2] [3 4 5] [6]]
assert(t.value.value == 1)
assert(t.value[0] == 2)
assert(t[0].value == 3)
assert(t[0][0] == 4)
assert(t[0][1] == 5)
assert(t[1][0] == 6)

// tree with value and nested children
t = [1 [2 3 4] [5 6 7]]
assert(t.value == 1)
assert(t[0].value == 2)
assert(t[0][0] == 3)
assert(t[0][1] == 4)
assert(t[1].value == 5)
assert(t[1][0] == 6)
assert(t[1][1] == 7)

// tree native function with direct arguments
t = tree(1, 2, 3, 4)
assert(t.value == 1)
assert(t[0] == 2)
assert(t[1] == 3)
assert(t[2] == 4)

// tree native function with sequence conversion
t = tree((1, 2, 3))
assert(t.value == 1)
assert(t[0] == 2)
assert(t[1] == 3)

// nested sequence conversion
t = tree((1, (2, (,)), (3, (,))))
assert(t.value == 1)
assert(t[0].value == 2)
assert(t[1].value == 3)

// more complex sequence conversion
t = tree((1, (2, 3, 4), (5, 6, 7)))
assert(t.value == 1)
assert(t[0].value == 2)
assert(t[0][0] == 3)
assert(t[0][1] == 4)
assert(t[1].value == 5)
assert(t[1][0] == 6)
assert(t[1][1] == 7)

// tree with different data types
t = [true false nil]
assert(t.value == true)
assert(t[0] == false)
assert(t[1] == nil)

// tree with strings
t = ["a" "b" "c"]
assert(t.value == "a")
assert(t[0] == "b")
assert(t[1] == "c")

// tree equality
let t1 = tree(1, 2, 3)
let t2 = tree(1, 2, 3)
assert(t1 == t2)

let t3 = tree(2, 2, 3)
assert(t2 != t3)

// expression trees
t = [(1 + 1) (2 + 2) (3 + 3)]
assert(t.value == 2)
assert(t[0] == 4)
assert(t[1] == 6)

// trees with function results
let double = x => x * 2
t = [(double(1)) (double(2)) (double(3))]
assert(t.value == 2)
assert(t[0] == 4)
assert(t[1] == 6)

// empty children sequence conversion
t = tree((5, (,), (,)))
assert(t.value == 5)
// two children with nil values
assert(t[0].value == nil)
assert(t[1].value == nil)
