let t

// empty tree
t = []


// simple leaf trees
t = [1]

assert(t[0] == 1)

t = [1 2 3]

assert(t[0] == 1)
assert(t[1] == 2)
assert(t[2] == 3)

// nested tree literals
t = [[1] [2] [3]]

assert(t[0][0] == 1)
assert(t[1][0] == 2)
assert(t[2][0] == 3)

// deeper nesting
t = [[1 2] [3 4 5] [6]]

assert(t[0][0] == 1)
assert(t[0][1] == 2)
assert(t[1][0] == 3)
assert(t[1][1] == 4)
assert(t[1][2] == 5)
assert(t[2][0] == 6)

// interior nodes with dot syntax
t = [.1 2 3]


// interior node with expression
t = [.(1 + 1) 2 3]


// nested interior nodes
t = [.1 [.2 3 4] [.5 6 7]]


// tree native function with direct arguments
t = tree(1, 2, 3, 4)

assert(t[0] == 2)
assert(t[1] == 3)
assert(t[2] == 4)

// tree native function with sequence conversion
t = tree((1, 2, 3))

assert(t[0] == 2)
assert(t[1] == 3)

// nested sequence conversion
t = tree((1, (2, (,)), (3, (,))))

print(t[0])
print(t[0][0])
// The nested empty sequences create empty trees
// t[0] is Tree(2, [Tree(nil, [])])
// t[0][0] is Tree(nil, [])

// more complex sequence conversion
t = tree((1, (2, 3, 4), (5, 6, 7)))

assert(t[0][0] == 3)
assert(t[0][1] == 4)
assert(t[1][0] == 6)
assert(t[1][1] == 7)

// tree with different data types
t = [true false nil]

assert(t[0] == true)
assert(t[1] == false)
assert(t[2] == nil)

// tree with strings
t = ["a" "b" "c"]

assert(t[0] == "a")
assert(t[1] == "b")
assert(t[2] == "c")

// tree equality (should work via default equality)
let t1 = tree(1, 2, 3)
let t2 = tree(1, 2, 3)
print(t1)
print(t2)

// expression trees
t = [(1 + 1) (2 + 2) (3 + 3)]

assert(t[0] == 2)
assert(t[1] == 4)
assert(t[2] == 6)

// trees with function results
global double = x => x * 2
t = [(double(1)) (double(2)) (double(3))]

assert(t[0] == 2)
assert(t[1] == 4)
assert(t[2] == 6)

// empty children sequence conversion
t = tree((5, (,), (,)))

// Tree with data 5 and two empty child trees with no children
// Just verify the tree was created successfully

