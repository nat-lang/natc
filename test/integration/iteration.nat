
// for loop.

let sum = 0
for (let i = 0; i < 5; i = i + 1) {
  sum = sum + i
}
assert(sum == 10)

// for loop, expression body.

let last
for (let i = 0; i < 3; i = i + 1) last = i
assert(last == 2)

// for in loop.

let sum = 0
for (x in (1,2,3)) {
  sum = sum + x
}
assert(sum == 6)

// for in loop, expression body.
let last = nil
for (y in (4,5)) last = y
assert(last == 5)
