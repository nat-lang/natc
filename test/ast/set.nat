let s

s = ({1})
assert(s[1])
assert(s[2] == nil)

s = ({1, 2, 1})
assert(s[1])
assert(s[2])
assert(s[3] == nil)

let fromCall = set(4, 5, 4)
assert(fromCall[4])
assert(fromCall[5])
assert(fromCall[6] == nil)

let comp = ({x | x in (1,2,3), x != 2})
assert(comp[1])
assert(comp[2] == nil)
assert(comp[3])

let empty = set()
assert(empty[1] == nil)


